# ── SwiftSwap backend config ─────────────────────────────────────────────
# Copy to .env and fill in real values. Never commit .env.

# Spotify app credentials (OWNER-ONLY step: register at https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must exactly match a Redirect URI registered on the Spotify app.
# Local dev default:
REDIRECT_URI=http://localhost:4000/auth/callback

# Where the frontend lives (used for CORS + post-login redirect)
FRONTEND_URL=http://localhost:5173

# Port this API listens on
PORT=4000

# Random long secret for signing session cookies / state. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_generate_a_random_64_char_hex_string

# development | production
NODE_ENV=development
